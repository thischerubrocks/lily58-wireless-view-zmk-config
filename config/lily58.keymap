#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&none             &kp PRINTSCREEN  &none  &none  &none  &none                                       &mt PLUS EQUAL  &none  &mt LEFT_BRACE LBKT  &mt RIGHT_BRACE RBKT  &mt UNDER MINUS  &kp RSHFT
&kp TAB           &kp Q            &kp W  &kp E  &kp R  &kp T                                       &kp Y           &kp U  &kp I                &kp O                 &kp P            &kp BACKSPACE
&kp CAPS          &kp A            &kp S  &kp D  &kp F  &kp G                                       &kp H           &kp J  &kp K                &kp L                 &mt SEMI COLON   &mt DOUBLE_QUOTES APOSTROPHE
&kp LEFT_CONTROL  &kp Z            &kp X  &kp C  &kp V  &kp B           &kp LEFT_ALT    &kp DELETE  &kp N           &kp M  &none                &mt PIPE BACKSLASH    &kp RIGHT_WIN    &kp RIGHT_CONTROL
                                          &mo 4  &mo 1  &kp LEFT_SHIFT  &kp SPACE       &kp RET     &kp SLASH       &mo 2  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp F1         &kp F2    &kp F3   &kp F4    &kp F5      &kp F6                           &kp F7     &kp F8      &kp F9        &kp F10               &kp F11                &kp F12
&kp BACKSPACE  &kp EXCL  &kp RET  &kp HASH  &kp DOLLAR  &kp PERCENT                      &kp CARET  &kp AMPS    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&none          &kp AT    &kp AT   &kp LEFT  &kp UP      &kp RIGHT                        &kp LEFT   &kp UP      &kp DOWN      &kp RIGHT             &none                  &trans
&none          &none     &none    &none     &kp DOWN    &none        &none     &kp BSPC  &none      &none       &none         &none                 &none                  &trans
                                  &trans    &none       &trans       &trans    &kp HOME  &kp COMMA  &kp PERIOD  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&kp ESC  &none  &none      &kp KP_N7  &kp KP_N8  &kp KP_N9                              &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp BSPC      &none  &none
&none    &none  &none      &kp KP_N4  &kp KP_N5  &kp KP_N6                              &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &none  &kp BSPC
&none    &none  &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3                              &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MINUS  &none  &none
&none    &none  &none      &none      &kp DOT    &none      &none         &kp KP_N0     &kp DOT    &none      &none      &none         &none  &none
                           &none      &none      &trans     &kp KP_NUM    &kp KP_ENTER  &none      &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&none        &bt BT_PRV  &bt BT_NXT  &none  &bt BT_CLR  &bt BT_CLR_ALL                  &none  &none  &none  &kp C_BRI_UP   &none  &kp C_VOLUME_UP
&bootloader  &none       &none       &none  &none       &none                           &none  &none  &none  &kp C_BRI_DEC  &none  &kp C_VOL_DN
&none        &none       &none       &none  &none       &none                           &none  &none  &none  &none          &none  &kp C_MUTE
&none        &none       &none       &none  &none       &none           &none    &none  &none  &none  &none  &none          &none  &none
                                     &none  &none       &none           &none    &none  &none  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans     &trans     &trans     &trans         &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)      &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans     &none      &none      &kp LC(LS(V))  &none   &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans         &none   &trans  &trans    &kp HOME  &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans         &trans  &trans  &trans    &trans    &trans  &trans  &trans
            >;
        };

        layer_5 {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                                       &kp Y           &kp U  &kp I                &kp O                 &kp P            &kp RSHFT
&kp CAPS   &kp A  &kp S  &kp D  &kp F  &kp G                                       &kp H           &kp J  &kp K                &kp L                 &mt UNDER MINUS  &kp BACKSPACE
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B                                       &kp N           &kp M  &mt LEFT_BRACE LBKT  &mt RIGHT_BRACE RBKT  &mt SEMI COLON   &mt DOUBLE_QUOTES APOSTROPHE
&mo 4      &none  &none  &none  &none  &none           &kp LEFT_ALT    &kp DELETE  &mt PLUS EQUAL  &none  &none                &mt PIPE BACKSLASH    &kp RIGHT_WIN    &kp RIGHT_CONTROL
                         &mo 2  &mo 1  &kp LEFT_SHIFT  &kp SPACE       &kp RET     &kp SLASH       &mo 2  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
