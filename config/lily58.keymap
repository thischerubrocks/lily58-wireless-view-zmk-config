#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC       &mt DOUBLE_QUOTES SINGLE_QUOTE  &kp LC(X)  &kp LC(C)        &kp LC(V)     &mo 2                                    &mt UNDER MINUS         &mt PLUS EQUAL           &mt LEFT_BRACE LBKT  &mt RIGHT_BRACE RBKT  &kp HOME            &kp RSHFT
&kp TAB       &mt EXCLAMATION Q               &mt AT W   &mt HASH E       &mt DOLLAR R  &mt PERCENT T                            &mt CARET Y             &mt AMPERSAND U          &mt ASTERISK I       &kp O                 &kp P               &kp BACKSPACE
&kp CAPS      &kp A                           &kp S      &kp D            &kp F         &kp G                                    &mt LEFT_PARENTHESIS H  &mt RIGHT_PARENTHESIS J  &kp K                &kp L                 &mt PIPE BACKSLASH  &kp RALT
&kp LEFT_ALT  &kp Z                           &kp X      &kp C            &kp V         &kp B           &kp LCTRL    &kp DELETE  &kp N                   &kp M                    &none                &none                 &kp RIGHT_WIN       &kp RIGHT_CONTROL
                                                         &kp PRINTSCREEN  &mo 1         &kp LEFT_SHIFT  &kp SPACE    &kp RET     &kp SLASH               &mo 2                    &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp F1         &kp F2    &kp F3  &kp F4     &kp F5  &kp F6                      &kp F7     &kp F8      &kp F9     &kp F10  &kp F11  &kp F12
&kp BACKSPACE  &kp N1    &kp N2  &kp N3     &kp N4  &kp N5                      &kp N6     &kp N7      &kp N8     &kp N9   &kp N0   &none
&kp ENTER      &kp LEFT  &kp UP  &kp RIGHT  &none   &none                       &none      &kp UP      &none      &none    &none    &trans
&kp DOWN       &none     &none   &none      &none   &none   &none     &kp BSPC  &kp LEFT   &kp DOWN    &kp RIGHT  &none    &none    &trans
                                 &trans     &none   &trans  &trans    &none     &kp COMMA  &kp PERIOD  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&kp ESC  &none   &none   &none    &none    &none                                &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS   &kp C_BRI_UP  &kp C_VOLUME_UP
&kp F1   &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                               &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_EQUAL  &kp C_BRI_DN  &kp C_VOLUME_DOWN
&kp F7   &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                              &kp KP_N1  &kp KP_N2  &kp KP_N3  &none         &none         &kp K_MUTE
&none    &none   &none   &none    &none    &none    &trans        &kp KP_N0     &none      &none      &none      &none         &none         &none
                         &none    &none    &trans   &kp KP_NUM    &kp KP_ENTER  &none      &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&none        &bt BT_PRV  &bt BT_NXT  &none  &bt BT_CLR  &bt BT_CLR_ALL                  &none  &none  &none  &none  &none  &none
&bootloader  &none       &none       &none  &none       &none                           &none  &none  &none  &none  &none  &none
&none        &none       &none       &none  &none       &none                           &none  &none  &none  &none  &none  &none
&none        &none       &none       &none  &none       &none           &none    &none  &none  &none  &none  &none  &none  &none
                                     &none  &none       &none           &none    &none  &none  &none  &none
            >;
        };

        layer_4 {
            display-name = "Base";
            bindings = <
&kp ESC        &mt EXCLAMATION Q  &mt AT W  &mt HASH E  &mt DOLLAR R  &mt PERCENT T                            &mt CARET Y             &mt AMPERSAND U          &mt ASTERISK I       &kp O                 &kp P      &kp HOME
&kp BACKSPACE  &kp A              &kp S     &kp D       &kp F         &kp G                                    &mt LEFT_PARENTHESIS H  &mt RIGHT_PARENTHESIS J  &kp K                &kp L                 &kp APOS   &kp BACKSPACE
&kp TAB        &kp Z              &kp X     &kp C       &kp V         &kp B                                    &kp N                   &kp M                    &kp SEMI             &none                 &kp BSLH   &kp RALT
&kp CAPS       &none              &none     &none       &none         &kp LALT        &kp LCTRL    &kp DELETE  &kp MINUS               &kp EQUAL                &mt LEFT_BRACE LBKT  &mt RIGHT_BRACE RBKT  &sk RSHFT  &kp RIGHT_WIN
                                            &kp LCTRL   &mo 1         &kp LEFT_SHIFT  &kp SPACE    &kp RET     &kp SLASH               &tog 2                   &tog 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
