#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <400>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp PRINTSCREEN  &kp LC(C)         &kp LC(V)   &kp LC(LS(V))     &kp LC(X)  &kp LC(Z)                                &kp RIGHT_ALT  &none      &mt LEFT_BRACE LBKT  &mt RIGHT_BRACE RBKT  &mt UNDER MINUS  &mt PLUS EQUAL
&kp TAB          &kp Q             &mt AT W    &kp E             &kp R      &kp T                                    &kp Y          &kp U      &kp I                &kp O                 &kp P            &kp BACKSPACE
&none            &mt LEFT_ARROW A  &mt DOWN S  &mt RIGHT D       &kp F      &kp G                                    &kp H          &kp J      &kp K                &kp L                 &mt SEMI COLON   &mt DOUBLE_QUOTES APOSTROPHE
&kp LEFT_ALT     &kp Z             &kp X       &kp C             &kp V      &kp B           &kp CAPS     &kp DELETE  &kp N          &kp M      &none                &mt PIPE BACKSLASH    &kp RIGHT_WIN    &kp RIGHT_CONTROL
                                               &kp LEFT_CONTROL  &mo 1      &kp LEFT_SHIFT  &kp SPACE    &kp RET     &mo 2          &kp SLASH  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp F1  &kp F2    &kp F3         &kp F4    &kp F5           &kp F6                           &kp F7     &kp F8      &kp F9        &kp F10               &kp F11                &kp F12
&none   &kp EXCL  &kp AT_SIGN    &kp HASH  &kp DOLLAR       &kp PERCENT                      &kp CARET  &kp AMPS    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&none   &none     &kp BACKSPACE  &kp UP    &kp ENTER        &none                            &kp LEFT   &kp UP      &kp DOWN      &kp RIGHT             &none                  &none
&none   &none     &kp LEFT       &kp DOWN  &kp RIGHT_ARROW  &none        &none     &kp BSPC  &none      &none       &none         &none                 &none                  &trans
                                 &trans    &none            &trans       &trans    &kp HOME  &kp COMMA  &kp PERIOD  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&kp ESC  &kp KP_N7  &kp KP_N8  &kp KP_N9   &none      &none                            &none         &kp KP_N7  &kp KP_N8  &kp KP_N9  &none         &none
&none    &kp KP_N4  &kp KP_N5  &kp KP_N6   &none      &none                            &kp KP_SLASH  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp BSPC
&none    &kp KP_N1  &kp KP_N2  &kp KP_N3   &none      &none                            &kp KP_DOT    &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MINUS  &none
&none    &kp KP_N0  &none      &kp KP_DOT  &none      &none   &kp KP_NUMLOCK    &none  &none         &kp KP_N0  &none      &none      &none         &none
                               &none       &kp ENTER  &trans  &none             &none  &none         &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&none        &bt BT_PRV  &bt BT_NXT  &none  &bt BT_CLR  &bt BT_CLR_ALL                  &none  &none  &none  &kp C_BRI_UP   &none  &kp C_VOLUME_UP
&bootloader  &none       &none       &none  &none       &none                           &none  &none  &none  &kp C_BRI_DEC  &none  &kp C_VOL_DN
&none        &none       &none       &none  &none       &none                           &none  &none  &none  &none          &none  &kp C_MUTE
&none        &none       &none       &none  &none       &none           &none    &none  &none  &none  &none  &none          &none  &none
                                     &none  &none       &none           &none    &none  &none  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans     &trans     &trans     &trans         &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)      &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans     &none      &none      &kp LC(LS(V))  &none   &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans         &none   &trans  &trans    &kp HOME  &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans         &trans  &trans  &trans    &trans    &trans  &trans  &trans
            >;
        };
    };
};
